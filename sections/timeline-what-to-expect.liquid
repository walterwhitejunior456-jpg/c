{% comment %}
  Timeline "What to Expect" Section
  - Tabbed interface with timeline milestones
  - Fully responsive: mobile-first, scales to desktop
{% endcomment %}

{{ 'section-timeline.css' | asset_url | stylesheet_tag }}

<section class="timeline-section" id="section-{{ section.id }}">
  <div class="timeline-container">

    {%- comment -%} Tab Navigation {%- endcomment -%}
    <div class="timeline-tabs">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
          <button
            class="timeline-tab{% if forloop.first %} timeline-tab--active{% endif %}"
            data-tab="{{ block.id }}"
            type="button"
          >
            {{ block.settings.tab_label }}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Heading {%- endcomment -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="timeline-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- comment -%} Timeline Cards {%- endcomment -%}
    <div class="timeline-cards">
      {%- for block in section.blocks -%}
        {%- if block.type == 'milestone' -%}
          <div class="timeline-card" {{ block.shopify_attributes }}>
            <div class="timeline-card__header">
              {%- if block.settings.icon != blank -%}
                <span class="timeline-card__icon">{{ block.settings.icon }}</span>
              {%- endif -%}
              <span class="timeline-card__day">DAY</span>
              <span class="timeline-card__number">{{ block.settings.day_number }}</span>
              <span class="timeline-card__phase">{{ block.settings.phase_name }}</span>
            </div>
            <ul class="timeline-card__list">
              {%- if block.settings.bullet_1 != blank -%}
                <li>{{ block.settings.bullet_1 }}</li>
              {%- endif -%}
              {%- if block.settings.bullet_2 != blank -%}
                <li>{{ block.settings.bullet_2 }}</li>
              {%- endif -%}
              {%- if block.settings.bullet_3 != blank -%}
                <li>{{ block.settings.bullet_3 }}</li>
              {%- endif -%}
              {%- if block.settings.bullet_4 != blank -%}
                <li>{{ block.settings.bullet_4 }}</li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
  /* =========================================
     TIMELINE SECTION - BASE / MOBILE FIRST
     ========================================= */
  #section-{{ section.id }} {
    --tl-bg: {{ section.settings.bg_color }};
    --tl-card-bg: {{ section.settings.card_bg_color }};
    --tl-accent: {{ section.settings.accent_color }};
    --tl-text: {{ section.settings.text_color }};
    --tl-heading: {{ section.settings.heading_color }};
    --tl-tab-bg: {{ section.settings.tab_bg_color }};
    --tl-tab-active-bg: {{ section.settings.tab_active_bg_color }};
    --tl-tab-text: {{ section.settings.tab_text_color }};
    --tl-tab-active-text: {{ section.settings.tab_active_text_color }};
  }

  #section-{{ section.id }} .timeline-section {
    background-color: var(--tl-bg);
    padding: 0;
    width: 100%;
  }

  #section-{{ section.id }} .timeline-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 16px 48px;
  }

  /* ---- TABS ---- */
  #section-{{ section.id }} .timeline-tabs {
    display: flex;
    justify-content: center;
    gap: 0;
    margin-bottom: 32px;
    border-radius: 8px 8px 0 0;
    overflow: hidden;
  }

  #section-{{ section.id }} .timeline-tab {
    flex: 1;
    max-width: 200px;
    padding: 14px 20px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: center;
    border: none;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
    background-color: var(--tl-tab-bg);
    color: var(--tl-tab-text);
    font-family: inherit;
    line-height: 1.3;
  }

  #section-{{ section.id }} .timeline-tab--active {
    background-color: var(--tl-tab-active-bg);
    color: var(--tl-tab-active-text);
  }

  #section-{{ section.id }} .timeline-tab:hover {
    background-color: var(--tl-tab-active-bg);
    color: var(--tl-tab-active-text);
  }

  /* ---- HEADING ---- */
  #section-{{ section.id }} .timeline-heading {
    color: var(--tl-heading);
    text-align: center;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 auto 36px;
    max-width: 480px;
    padding: 0 8px;
  }

  /* ---- CARDS ---- */
  #section-{{ section.id }} .timeline-cards {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  #section-{{ section.id }} .timeline-card {
    background-color: var(--tl-card-bg);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 24px 24px 28px;
  }

  #section-{{ section.id }} .timeline-card__header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  #section-{{ section.id }} .timeline-card__icon {
    font-size: 22px;
    line-height: 1;
    margin-right: 2px;
  }

  #section-{{ section.id }} .timeline-card__day {
    color: var(--tl-accent);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #section-{{ section.id }} .timeline-card__number {
    color: var(--tl-accent);
    font-size: 32px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  #section-{{ section.id }} .timeline-card__phase {
    color: var(--tl-heading);
    font-size: 20px;
    font-weight: 700;
    margin-left: 4px;
  }

  /* ---- BULLET LIST ---- */
  #section-{{ section.id }} .timeline-card__list {
    list-style: disc;
    padding-left: 20px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #section-{{ section.id }} .timeline-card__list li {
    color: var(--tl-text);
    font-size: 15px;
    line-height: 1.5;
    padding-left: 4px;
  }

  #section-{{ section.id }} .timeline-card__list li::marker {
    color: var(--tl-text);
  }

  /* =========================================
     TABLET (600px+)
     ========================================= */
  @media screen and (min-width: 600px) {
    #section-{{ section.id }} .timeline-container {
      padding: 0 32px 60px;
    }

    #section-{{ section.id }} .timeline-heading {
      font-size: 28px;
      max-width: 560px;
      margin-bottom: 44px;
    }

    #section-{{ section.id }} .timeline-tab {
      font-size: 15px;
      padding: 16px 28px;
    }

    #section-{{ section.id }} .timeline-card {
      padding: 28px 32px 32px;
    }

    #section-{{ section.id }} .timeline-card__number {
      font-size: 36px;
    }

    #section-{{ section.id }} .timeline-card__phase {
      font-size: 22px;
    }

    #section-{{ section.id }} .timeline-card__list li {
      font-size: 16px;
    }
  }

  /* =========================================
     DESKTOP (900px+)
     ========================================= */
  @media screen and (min-width: 900px) {
    #section-{{ section.id }} .timeline-container {
      padding: 0 48px 80px;
    }

    #section-{{ section.id }} .timeline-tabs {
      margin-bottom: 40px;
    }

    #section-{{ section.id }} .timeline-tab {
      font-size: 16px;
      padding: 16px 36px;
      max-width: 220px;
    }

    #section-{{ section.id }} .timeline-heading {
      font-size: 32px;
      max-width: 620px;
      margin-bottom: 48px;
    }

    #section-{{ section.id }} .timeline-cards {
      gap: 24px;
    }

    #section-{{ section.id }} .timeline-card {
      padding: 32px 40px 36px;
      border-radius: 20px;
    }

    #section-{{ section.id }} .timeline-card__icon {
      font-size: 26px;
    }

    #section-{{ section.id }} .timeline-card__number {
      font-size: 40px;
    }

    #section-{{ section.id }} .timeline-card__phase {
      font-size: 24px;
    }

    #section-{{ section.id }} .timeline-card__list {
      gap: 12px;
    }

    #section-{{ section.id }} .timeline-card__list li {
      font-size: 17px;
    }
  }
</style>

<script>
  (function() {
    var section = document.getElementById('section-{{ section.id }}');
    if (!section) return;
    var tabs = section.querySelectorAll('.timeline-tab');
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('timeline-tab--active'); });
        tab.classList.add('timeline-tab--active');
      });
    });
  })();
</script>

